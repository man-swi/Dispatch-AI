      "name": "Prepare Escalation"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Parse Delay Extraction JSON').first().json;\n\nconst etaText = data.updated_eta || \"\";\nconst reason = (data.delay_reason || \"\").toLowerCase();\n\nlet severity = \"medium\";\n\nconst etaNumber = parseInt(etaText);\n\nif (reason.includes(\"breakdown\") || reason.includes(\"unreachable\")) {\n    severity = \"critical\";\n}\nelse if (!isNaN(etaNumber)) {\n\n    if (etaNumber < 30) {\n        severity = \"low\";\n    }\n    else if (etaNumber >= 30 && etaNumber <= 120) {\n        severity = \"medium\";\n    }\n    else if (etaNumber > 120) {\n        severity = \"high\";\n    }\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      severity\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
